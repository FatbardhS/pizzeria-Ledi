---
// Staff page: upload the Wochenkarte photo, set menu prices, change the password.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { menu, itemKey } from '../data/menu';
import { isAdmin, hasPassword } from '../lib/auth';
import { isConfigured, listPrices, listWeeklyPhotos } from '../lib/store';

export const prerender = false;

const loggedIn = await isAdmin(Astro.cookies);
const failed = Astro.url.searchParams.has('fehler');
const noPassword = !(await hasPassword());
const configured = isConfigured();
const [weekly, prices] = loggedIn ? await Promise.all([listWeeklyPhotos(), listPrices()]) : [[], {}];

const priceMenu = menu.map((cat) => ({
  id: cat.id,
  title: cat.title,
  items: cat.items.map((item) => ({ key: itemKey(cat, item), nr: item.nr, name: item.name, desc: item.desc })),
}));

const field =
  'mt-1.5 w-full rounded-xl border border-ink/10 bg-white px-4 py-3 text-base outline-none transition focus:border-tomato focus:ring-2 focus:ring-tomato/20';
---

<Base title="Verwaltung">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  {
    !loggedIn ? (
      <section class="flex min-h-[100svh] items-center justify-center px-4 py-10">
        <form method="post" action="/api/admin/login" class="w-full max-w-sm rounded-[2rem] bg-white p-8 shadow-xl ring-1 ring-ink/5">
          <p class="font-script text-center text-5xl leading-none text-tomato">Ledi</p>
          <h1 class="font-display mt-3 text-center text-2xl">Verwaltung</h1>
          {noPassword ? (
            <p class="mt-6 rounded-xl bg-tomato/10 px-4 py-3 text-sm text-tomato-dark">
              Es ist noch kein Passwort eingerichtet (ADMIN_PASSWORD in Vercel).
            </p>
          ) : (
            <>
              <label class="mt-6 block text-sm font-medium">
                Passwort
                <input name="password" type="password" autocomplete="current-password" required autofocus class={field} />
              </label>
              {failed && <p class="mt-3 text-sm text-tomato-dark">Falsches Passwort.</p>}
              <button class="btn-primary mt-6 w-full !py-3.5">Anmelden</button>
            </>
          )}
        </form>
      </section>
    ) : (
      <div class="mx-auto max-w-3xl px-4 pt-6 pb-32">
        <header class="flex items-center justify-between gap-4">
          <div>
            <p class="font-script text-4xl leading-none text-tomato">Ledi</p>
            <p class="text-xs font-semibold tracking-[0.25em] text-ink-soft uppercase">Verwaltung</p>
          </div>
          <form method="post" action="/api/admin/login">
            <input type="hidden" name="logout" value="1" />
            <button class="btn-outline !px-4 !py-2">Abmelden</button>
          </form>
        </header>

        {!configured && (
          <p class="mt-5 rounded-2xl bg-gold/15 px-4 py-3 text-sm text-[#7a5612]">
            <strong>Testmodus:</strong> Supabase ist nicht verbunden – Änderungen gehen beim Neustart verloren.
          </p>
        )}

        <nav class="mt-6 grid grid-cols-3 rounded-full bg-cream-dark p-1" role="tablist">
          <button role="tab" data-tab="weekly" aria-selected="true" class="tab">Wochenkarte</button>
          <button role="tab" data-tab="prices" aria-selected="false" class="tab">Preise</button>
          <button role="tab" data-tab="account" aria-selected="false" class="tab">Konto</button>
        </nav>

        <!-- Weekly menu photos -->
        <section data-panel="weekly" class="mt-6">
          <h1 class="font-display text-3xl">Wochenkarte</h1>
          <p class="mt-1 text-sm text-ink-soft">Foto der Wochenkarte hochladen – es erscheint oben auf der Speisekarte.</p>

          <form id="upload" class="mt-5 rounded-3xl bg-white p-5 shadow-lg ring-1 ring-ink/5" novalidate>
            <label class="upload-drop">
              <input id="photo-input" name="photo" type="file" accept="image/*" class="sr-only" />
              <img id="photo-preview" alt="" hidden class="max-h-72 w-full rounded-2xl object-contain" />
              <span id="photo-hint" class="flex flex-col items-center gap-2 text-center">
                <span class="grid size-14 place-items-center rounded-full bg-tomato/10 text-tomato">
                  <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"/><circle cx="12" cy="13" r="3.5"/></svg>
                </span>
                <span class="font-semibold">Foto aufnehmen oder auswählen</span>
                <span class="text-xs text-ink-soft">JPG oder PNG – große Fotos werden automatisch verkleinert</span>
              </span>
            </label>

            <fieldset class="mt-4">
              <legend class="text-sm font-medium">Anzeigen bei</legend>
              <div class="mt-1.5 grid grid-cols-3 gap-2">
                {[['ledi', 'Ledi'], ['due', 'Ledi Due'], ['both', 'Beiden']].map(([value, label]) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="location" value={value} class="peer sr-only" checked={value === 'ledi'} />
                    <span class="flex h-11 items-center justify-center rounded-xl border border-ink/10 text-sm font-semibold transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-cream">
                      {label}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
            <p id="upload-error" class="mt-3 hidden text-sm text-tomato-dark" role="alert"></p>
            <button id="upload-button" class="btn-primary mt-5 w-full !py-3" disabled>Hochladen</button>
          </form>

          <ul id="weekly-list" class="mt-6 grid gap-4 sm:grid-cols-2"></ul>
          <p id="weekly-empty" class="mt-6 hidden rounded-3xl border border-dashed border-ink/15 p-8 text-center text-ink-soft">
            Noch keine Wochenkarte hochgeladen.
          </p>
        </section>

        <!-- Account -->
        <section data-panel="account" class="mt-6" hidden>
          <h1 class="font-display text-3xl">Passwort ändern</h1>
          <p class="mt-1 text-sm text-ink-soft">Danach müssen sich alle anderen Geräte neu anmelden.</p>
          <form id="password-form" class="mt-5 space-y-3 rounded-3xl bg-white p-5 ring-1 ring-ink/5" novalidate>
            <label class="block text-sm font-medium">
              Aktuelles Passwort
              <input name="current" type="password" autocomplete="current-password" required class={field} />
            </label>
            <label class="block text-sm font-medium">
              Neues Passwort <span class="font-normal text-ink-soft">(mind. 8 Zeichen)</span>
              <input name="next" type="password" autocomplete="new-password" minlength="8" required class={field} />
            </label>
            <label class="block text-sm font-medium">
              Neues Passwort wiederholen
              <input name="repeat" type="password" autocomplete="new-password" required class={field} />
            </label>
            <p id="password-error" class="hidden text-sm text-tomato-dark" role="alert"></p>
            <button class="btn-primary w-full !py-3">Passwort speichern</button>
          </form>
        </section>

        <!-- Prices -->
        <section data-panel="prices" class="mt-6" hidden>
          <h1 class="font-display text-3xl">Preise</h1>
          <p class="mt-1 text-sm text-ink-soft">
            Nur Gerichte mit Preis können online bestellt werden. Feld leer lassen = nicht bestellbar.
          </p>
          <input id="price-search" type="search" placeholder="Gericht suchen…" class={`${field} mt-4`} />
          <div id="price-list" class="mt-4 space-y-6">
            {priceMenu.map((cat) => (
              <div data-price-cat>
                <h2 class="font-display text-xl">{cat.title}</h2>
                <ul class="mt-2 divide-y divide-ink/5 rounded-2xl bg-white ring-1 ring-ink/5">
                  {cat.items.map((item) => (
                    <li data-price-row data-search={`${item.nr ?? ''} ${item.name}`.toLowerCase()} class="flex items-center gap-3 px-4 py-2.5">
                      <span class="w-6 shrink-0 text-sm text-tomato/60">{item.nr}</span>
                      <span class="min-w-0 flex-1 text-sm">
                        <span class="block font-medium">{item.name}</span>
                        {item.desc && <span class="block truncate text-xs text-ink-soft">{item.desc}</span>}
                      </span>
                      <label class="relative w-24 shrink-0">
                        <span class="sr-only">Preis für {item.name}</span>
                        <input
                          data-key={item.key}
                          inputmode="decimal"
                          placeholder="–"
                          class="w-full rounded-lg border border-ink/10 bg-cream py-2 pr-7 pl-3 text-right text-base outline-none focus:border-tomato data-[dirty]:border-gold data-[dirty]:bg-gold/10"
                        />
                        <span class="pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 text-sm text-ink-soft">€</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="fixed inset-x-0 bottom-0 z-40 border-t border-ink/10 bg-cream/95 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md">
            <div class="mx-auto flex max-w-3xl items-center gap-3">
              <p id="price-status" class="flex-1 text-sm text-ink-soft">Keine Änderungen</p>
              <button id="save-prices" class="btn-primary !py-3" disabled>Preise speichern</button>
            </div>
          </div>
        </section>
      </div>
    )
  }

  <script is:inline type="application/json" id="admin-data" set:html={JSON.stringify({ weekly, prices }).replace(/</g, '\\u003c')} />
  <div id="toast" class="pointer-events-none fixed top-4 left-1/2 z-[95] -translate-x-1/2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-cream opacity-0 shadow-lg transition"></div>
</Base>

<style>
  .tab {
    border-radius: 999px;
    padding: 0.65rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: all 0.2s ease;
  }
  .tab[aria-selected='true'] {
    background: white;
    color: var(--color-ink);
    box-shadow: 0 1px 4px rgb(28 25 23 / 0.12);
  }
  .upload-drop {
    display: flex;
    min-height: 11rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border-radius: 1.25rem;
    border: 2px dashed rgb(28 25 23 / 0.15);
    background: var(--color-cream);
    padding: 1rem;
    transition: border-color 0.2s ease;
  }
  .upload-drop:hover,
  .upload-drop:focus-within {
    border-color: var(--color-tomato);
  }
  #upload-button:disabled {
    opacity: 0.45;
    pointer-events: none;
  }
  #save-prices:disabled {
    opacity: 0.45;
    pointer-events: none;
  }
</style>

<script>
  import type { WeeklyPhoto } from '../lib/store';

  const dataEl = document.getElementById('admin-data');
  const list = document.getElementById('weekly-list');
  if (dataEl && list) {
    const data = JSON.parse(dataEl.textContent || '{}') as { weekly: WeeklyPhoto[]; prices: Record<string, number> };
    let weekly = data.weekly;

    const parsePrice = (s: string) => {
      const clean = s.trim().replace(/\s|€/g, '').replace(',', '.');
      if (!clean) return null;
      const n = Number(clean);
      return Number.isFinite(n) && n >= 0 ? Math.round(n * 100) / 100 : NaN;
    };
    const toast = (msg: string) => {
      const t = document.getElementById('toast')!;
      t.textContent = msg;
      t.style.opacity = '1';
      setTimeout(() => (t.style.opacity = '0'), 2200);
    };
    const send = async (url: string, method: string, body?: unknown) => {
      const res = await fetch(url, {
        method,
        headers: body ? { 'Content-Type': 'application/json' } : undefined,
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 401) location.reload();
      if (!res.ok) throw new Error((await res.text()) || 'Fehler beim Speichern');
      return res.status === 204 ? null : res.json();
    };

    // Tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const showTab = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
      try {
        sessionStorage.setItem('ledi-admin-tab', id);
      } catch {}
    };
    tabs.forEach((t) => t.addEventListener('click', () => showTab(t.dataset.tab!)));
    try {
      const saved = sessionStorage.getItem('ledi-admin-tab');
      if (saved) showTab(saved);
    } catch {}

    // ---- Wochenkarte photos ----
    const places = { ledi: 'Ledi', due: 'Ledi Due', both: 'Beiden' } as const;
    const uploadForm = document.getElementById('upload') as HTMLFormElement;
    const input = document.getElementById('photo-input') as HTMLInputElement;
    const preview = document.getElementById('photo-preview') as HTMLImageElement;
    const hint = document.getElementById('photo-hint')!;
    const uploadButton = document.getElementById('upload-button') as HTMLButtonElement;
    const uploadError = document.getElementById('upload-error')!;
    let shrunk: Blob | null = null;

    const showError = (msg: string) => {
      uploadError.textContent = msg;
      uploadError.classList.toggle('hidden', !msg);
    };
    const resetUpload = () => {
      uploadForm.reset();
      shrunk = null;
      preview.hidden = true;
      hint.hidden = false;
      uploadButton.disabled = true;
    };

    // Phone photos are often 5–10 MB: scale to max. 2000 px and save as JPEG (a few hundred KB) before uploading.
    const shrink = async (file: File) => {
      const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
      const scale = Math.min(1, 2000 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      const ctx = canvas.getContext('2d')!;
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      return new Promise<Blob>((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error())), 'image/jpeg', 0.85));
    };

    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      shrunk = null;
      uploadButton.disabled = true;
      showError('');
      if (!file) return;
      try {
        shrunk = await shrink(file);
        preview.src = URL.createObjectURL(shrunk);
        preview.hidden = false;
        hint.hidden = true;
        uploadButton.disabled = false;
      } catch {
        showError('Dieses Bildformat wird nicht unterstützt – bitte ein JPG- oder PNG-Foto wählen.');
      }
    });

    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!shrunk) return;
      const fd = new FormData();
      fd.append('photo', new File([shrunk], 'wochenkarte.jpg', { type: 'image/jpeg' }));
      fd.append('location', String(new FormData(uploadForm).get('location')));
      uploadButton.disabled = true;
      uploadButton.textContent = 'Wird hochgeladen…';
      try {
        const res = await fetch('/api/admin/weekly', { method: 'POST', body: fd });
        if (res.status === 401) location.reload();
        if (!res.ok) throw new Error((await res.text()) || 'Fehler beim Hochladen');
        weekly = [(await res.json()) as WeeklyPhoto, ...weekly];
        render();
        resetUpload();
        toast('Wochenkarte hochgeladen ✓');
      } catch (err) {
        showError((err as Error).message);
        uploadButton.disabled = false;
      }
      uploadButton.textContent = 'Hochladen';
    });

    const render = () => {
      document.getElementById('weekly-empty')!.classList.toggle('hidden', weekly.length > 0);
      list.innerHTML = weekly
        .map(
          (w) => `
        <li class="overflow-hidden rounded-3xl bg-white ring-1 ring-ink/5 ${w.active ? '' : 'opacity-60'}">
          <a href="/api/wochenkarte/${w.id}" target="_blank" rel="noopener" class="block bg-cream-dark">
            <img src="/api/wochenkarte/${w.id}" alt="Wochenkarte" loading="lazy" class="h-56 w-full object-contain" />
          </a>
          <div class="space-y-3 p-4">
            <p class="text-xs text-ink-soft">Hochgeladen am ${new Date(w.createdAt).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}${w.active ? '' : ' · <strong>ausgeblendet</strong>'}</p>
            <label class="flex items-center gap-2 text-sm font-medium">
              Anzeigen bei
              <select data-location="${w.id}" class="flex-1 rounded-lg border border-ink/10 bg-cream px-3 py-2 text-base">
                ${Object.entries(places).map(([v, l]) => `<option value="${v}" ${v === w.location ? 'selected' : ''}>${l}</option>`).join('')}
              </select>
            </label>
            <div class="flex gap-2">
              <button data-toggle="${w.id}" class="btn-outline flex-1 !py-2">${w.active ? 'Ausblenden' : 'Einblenden'}</button>
              <button data-delete="${w.id}" class="btn-outline !py-2 !text-tomato">Löschen</button>
            </div>
          </div>
        </li>`,
        )
        .join('');
    };

    const replace = (photo: WeeklyPhoto) => {
      weekly = weekly.map((w) => (w.id === photo.id ? photo : w));
      render();
    };

    list.addEventListener('change', async (e) => {
      const select = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-location]');
      if (!select) return;
      try {
        replace(await send('/api/admin/weekly', 'PATCH', { id: select.dataset.location, location: select.value }));
        toast('Gespeichert ✓');
      } catch (err) {
        toast((err as Error).message);
      }
    });

    list.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const photo = weekly.find((w) => w.id === (btn.dataset.toggle ?? btn.dataset.delete));
      if (!photo) return;
      try {
        if (btn.dataset.toggle) {
          replace(await send('/api/admin/weekly', 'PATCH', { id: photo.id, active: !photo.active }));
          toast(photo.active ? 'Ausgeblendet' : 'Wieder sichtbar');
        } else if (confirm('Dieses Foto wirklich löschen?')) {
          await send(`/api/admin/weekly?id=${encodeURIComponent(photo.id)}`, 'DELETE');
          weekly = weekly.filter((w) => w.id !== photo.id);
          render();
          toast('Gelöscht');
        }
      } catch (err) {
        toast((err as Error).message);
      }
    });
    render();

    // ---- Prices ----
    const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-key]')];
    const saveBtn = document.getElementById('save-prices') as HTMLButtonElement;
    const status = document.getElementById('price-status')!;
    let saved = { ...data.prices };
    const show = (n: number | undefined) => (n === undefined ? '' : n.toFixed(2).replace('.', ','));
    inputs.forEach((i) => (i.value = show(saved[i.dataset.key!])));

    const changes = () => {
      const out: Record<string, number | null> = {};
      let invalid = 0;
      inputs.forEach((i) => {
        const p = parsePrice(i.value);
        if (Number.isNaN(p)) return invalid++;
        if ((p ?? undefined) !== saved[i.dataset.key!]) out[i.dataset.key!] = p;
      });
      return { out, invalid };
    };
    const refresh = () => {
      const { out, invalid } = changes();
      const n = Object.keys(out).length;
      inputs.forEach((i) => i.toggleAttribute('data-dirty', i.dataset.key! in out || Number.isNaN(parsePrice(i.value))));
      status.textContent = invalid ? `${invalid} ungültige Eingabe(n)` : n ? `${n} Änderung(en)` : 'Keine Änderungen';
      saveBtn.disabled = !n || invalid > 0;
    };
    inputs.forEach((i) => i.addEventListener('input', refresh));

    saveBtn.addEventListener('click', async () => {
      const { out } = changes();
      saveBtn.disabled = true;
      try {
        await send('/api/admin/prices', 'POST', { prices: out });
        for (const [k, v] of Object.entries(out)) {
          if (v === null) delete saved[k];
          else saved[k] = v;
        }
        inputs.forEach((i) => (i.value = show(saved[i.dataset.key!])));
        refresh();
        toast('Preise gespeichert ✓');
      } catch (err) {
        toast((err as Error).message);
        refresh();
      }
    });

    const search = document.getElementById('price-search') as HTMLInputElement;
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('[data-price-row]').forEach((r) => (r.hidden = !!q && !r.dataset.search!.includes(q)));
      document.querySelectorAll<HTMLElement>('[data-price-cat]').forEach(
        (c) => (c.hidden = !c.querySelector('[data-price-row]:not([hidden])')),
      );
    });

    // ---- Password ----
    const pwForm = document.getElementById('password-form') as HTMLFormElement;
    const pwError = document.getElementById('password-error')!;
    pwForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(pwForm);
      const next = String(fd.get('next'));
      const msg =
        next.trim().length < 8 ? 'Das neue Passwort muss mindestens 8 Zeichen haben.'
        : next !== String(fd.get('repeat')) ? 'Die neuen Passwörter stimmen nicht überein.'
        : '';
      pwError.textContent = msg;
      pwError.classList.toggle('hidden', !msg);
      if (msg) return;
      try {
        await send('/api/admin/password', 'POST', { current: fd.get('current'), next });
        pwForm.reset();
        toast('Passwort geändert ✓');
      } catch (err) {
        pwError.textContent = (err as Error).message;
        pwError.classList.remove('hidden');
      }
    });

    window.addEventListener('beforeunload', (e) => {
      if (Object.keys(changes().out).length) e.preventDefault();
    });
  }
</script>
