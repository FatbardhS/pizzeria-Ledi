---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { images, reviews, locationPaths } from '../../data/site';
import { menu } from '../../data/menu';

export const getStaticPaths = locationPaths;
const { location: site } = Astro.props;

const pizzas = menu.find((c) => c.id === 'pizze')!.items;
const favourites = ['21', '13', '09', '01'].map((nr) => pizzas.find((p) => p.nr === nr)!);

const years = new Date().getFullYear() - 2011;
const heroWords = ['Pizza,', 'mit', 'Liebe', 'gebacken.'];

const highlights = [
  { icon: 'flame', title: 'Steinofen', text: 'Ohne Blech gebacken – für den knusprigen, luftigen Rand.' },
  { icon: 'leaf', title: 'Frisch belegt', text: 'Feinstes, frisches Gemüse und ausschließlich Mozzarella.' },
  { icon: 'clock', title: 'Vor Ihren Augen', text: 'Jeder Teig wird von Hand gemacht – seit März 2011.' },
] as const;
---

<Base location={site} overlayHeader>
  <!-- Hero -->
  <section data-hero class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-ink text-white md:items-center">
    <div data-parallax="0.25" class="absolute -inset-y-[12%] inset-x-0 -z-10">
      <img src={images.hero} alt="" class="ken-burns size-full object-cover" fetchpriority="high" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-ink/20 md:bg-gradient-to-r md:from-ink/90 md:via-ink/50 md:to-transparent"></div>

    <div class="container-page pt-28 pb-24 md:py-0">
      <p class="eyebrow hero-in !text-gold" style="--delay:150ms">{site.heroEyebrow}</p>
      <h1 class="font-display mt-2 max-w-2xl text-5xl leading-[1.05] sm:text-6xl md:text-7xl" aria-label="Pizza, mit Liebe gebacken.">
        {
          heroWords.map((w, i) => (
            <Fragment>
              <span class="inline-block overflow-hidden pb-1 align-bottom" aria-hidden="true">
                <span class:list={['hero-word', i === heroWords.length - 1 && 'text-tomato']} style={`--delay:${300 + i * 110}ms`}>
                  {w}
                </span>
              </span>{' '}
            </Fragment>
          ))
        }
      </h1>
      <p class="hero-in mt-5 max-w-md text-base text-white/80 sm:text-lg" style="--delay:850ms">
        Dünner Teig, hochwertige Mehle und frische Zutaten – direkt aus dem Steinofen in Berlin-Lichtenberg.
      </p>
      <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row" style="--delay:1000ms">
        <a href={`/${site.id}/reservierung`} class="btn-primary">
          <Icon name="calendar" class="size-4" /> Tisch reservieren
        </a>
        <a href={`/${site.id}/speisekarte`} class="btn-ghost">
          Speisekarte ansehen <Icon name="arrow" class="size-4" />
        </a>
      </div>
      <p class="hero-in mt-8 flex items-center gap-2 text-sm text-white/70" style="--delay:1150ms">
        <span class="relative flex size-2.5">
          <span id="open-ping" class="absolute inline-flex size-full animate-ping rounded-full bg-gold opacity-75"></span>
          <span id="open-dot" class="relative inline-flex size-2.5 rounded-full bg-gold"></span>
        </span>
        <span id="open-status" data-schedule={JSON.stringify(site.schedule)}>{site.hoursShort}</span>
        <span class="hidden sm:inline">· {site.address.street}</span>
      </p>
    </div>

    <div class="hero-in absolute bottom-6 left-1/2 hidden -translate-x-1/2 md:block" style="--delay:1500ms" aria-hidden="true">
      <div class="flex h-10 w-6 justify-center rounded-full border-2 border-white/40 pt-2">
        <span class="scroll-hint block h-2 w-1 rounded-full bg-white"></span>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="container-page grid items-center gap-10 py-20 md:grid-cols-2 md:gap-16 md:py-28">
    <div class="relative">
      <img
        src={images.gallery[0].src}
        alt={images.gallery[0].alt}
        class="reveal-mask aspect-[4/5] w-full rounded-3xl object-cover shadow-2xl shadow-ink/20"
        loading="lazy"
      />
      <div class="reveal-scale absolute -right-2 -bottom-6 sm:-right-6" style="--delay:700ms">
        <div class="float rounded-2xl bg-tomato px-5 py-4 text-white shadow-xl">
          <p class="font-display text-3xl leading-none"><span data-count={years}>{years}</span>+</p>
          <p class="text-xs tracking-wider uppercase opacity-90">Jahre Leidenschaft</p>
        </div>
      </div>
    </div>
    <div class="reveal-right">
      <p class="eyebrow">Trattoria {site.shortName}</p>
      <h2 class="font-display mt-1 text-4xl leading-tight md:text-5xl">Ganz ursprüngliche Pizza.</h2>
      <p class="mt-5 text-lg text-ink-soft">
        {site.aboutIntro} dünner Teig, hochwertige Mehle, als Basisbelag ausschließlich Mozzarella – durchweg vor dem Auge des Gastes handgemacht.
      </p>
      <p class="mt-4 text-ink-soft">
        Belegt mit feinstem, frischem Gemüse wird jede Pizza mit Individualität und Liebe zum Detail zubereitet.
      </p>
      <ul data-stagger="120" class="mt-8 grid gap-4 sm:grid-cols-3 md:grid-cols-1 lg:grid-cols-3">
        {
          highlights.map((h) => (
            <li class="reveal rounded-2xl bg-white p-5 shadow-sm ring-1 ring-ink/5">
              <Icon name={h.icon} class="size-6 text-tomato" />
              <p class="mt-3 font-semibold">{h.title}</p>
              <p class="mt-1 text-sm text-ink-soft">{h.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Favourites -->
  <section class="bg-cream-dark py-20 md:py-28">
    <div class="container-page">
      <div class="reveal flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">Aus dem Steinofen</p>
          <h2 class="font-display mt-1 text-4xl md:text-5xl">Unsere Lieblinge</h2>
        </div>
        <a href={`/${site.id}/speisekarte`} class="group inline-flex items-center gap-2 font-semibold text-tomato">
          Zur ganzen Karte <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
        </a>
      </div>

      <!-- Swipe on phones, grid on larger screens -->
      <div data-stagger="110" class="scrollbar-none -mx-4 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:grid-cols-4">
        {
          favourites.map((p, i) => (
            <article class="reveal flex w-[78%] shrink-0 snap-start flex-col rounded-3xl bg-white p-6 shadow-sm ring-1 ring-ink/5 transition hover:-translate-y-1 hover:shadow-xl sm:w-auto">
              <div class="flex items-center justify-between">
                <span class="font-display text-5xl text-tomato/20">{p.nr}</span>
                {p.tags?.includes('Haus-Tipp') && (
                  <span class="rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-[#8a6418]">Haus-Tipp</span>
                )}
                {p.tags?.includes('vegetarisch') && (
                  <span class="rounded-full bg-basil/10 px-3 py-1 text-xs font-semibold text-basil">Vegetarisch</span>
                )}
              </div>
              <h3 class="font-display mt-4 text-2xl">{p.name.replace('Pizza ', '')}</h3>
              <p class="mt-2 flex-1 text-sm text-ink-soft">{p.desc}</p>
              <p class="mt-5 text-xs tracking-wider text-ink-soft/70 uppercase">ø 33 cm · Steinofen</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Weekly menu -->
  <section class="container-page py-20 md:py-28">
    <div class="reveal-scale relative isolate overflow-hidden rounded-[2rem] bg-ink px-6 py-14 text-white sm:px-12 md:py-20">
      <div data-parallax="0.15" class="absolute -inset-y-[20%] inset-x-0 -z-10">
        <img src={images.gallery[1].src} alt="" class="size-full object-cover opacity-40" loading="lazy" />
      </div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/80 to-ink/30"></div>
      <p class="eyebrow !text-gold">Jede Woche neu</p>
      <h2 class="font-display mt-1 max-w-lg text-4xl md:text-5xl">Wöchentliche Empfehlung</h2>
      <p class="mt-4 max-w-md text-white/80">
        Hausgemachte Pasta, Gnocchi und Spezialitäten vom Grill – unsere Wochenkarte wechselt regelmäßig.
      </p>
      <a href={`/${site.id}/speisekarte#wochenkarte`} class="btn-primary mt-8">
        <Icon name="file" class="size-4" /> Wochenkarte ansehen
      </a>
    </div>
  </section>

  <!-- Reviews -->
  <section class="pb-20 md:pb-28">
    <div class="container-page reveal text-center">
      <p class="eyebrow">Bewertungen</p>
      <h2 class="font-display mt-1 text-4xl md:text-5xl">{site.id === 'due' ? 'Was Gäste über Ledi sagen' : 'Was unsere Gäste sagen'}</h2>
    </div>
    <div data-stagger="110" class="scrollbar-none container-page mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 md:grid md:grid-cols-2 md:overflow-visible lg:grid-cols-4">
      {
        reviews.map((r) => (
          <figure class="reveal flex w-[85%] shrink-0 snap-center flex-col rounded-3xl bg-white p-6 shadow-sm ring-1 ring-ink/5 md:w-auto">
            <div class="flex gap-0.5 text-gold">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
            </div>
            <blockquote class="mt-4 flex-1">
              <p class="font-display text-lg">“{r.title}”</p>
              <p class="mt-2 text-sm text-ink-soft">{r.text}</p>
            </blockquote>
            <figcaption class="mt-5 text-sm font-semibold">{r.author}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <a href={site.reviewUrl} target="_blank" rel="noopener" class="btn-outline">
        <Icon name="star" class="size-4 text-gold" /> {site.name} bewerten
      </a>
    </div>
  </section>

  <!-- Outdoor teaser -->
  <section class="relative isolate overflow-hidden">
    <div data-parallax="0.3" class="absolute -inset-y-[25%] inset-x-0 -z-10">
      <img src={images.outside} alt={`Außenbereich der ${site.name}`} class="size-full object-cover" loading="lazy" />
    </div>
    <div class="absolute inset-0 -z-10 bg-ink/60"></div>
    <div class="container-page reveal py-24 text-center text-white md:py-36">
      <p class="eyebrow !text-gold">Ruhig & gemütlich</p>
      <h2 class="font-display mx-auto mt-1 max-w-xl text-4xl md:text-5xl">Ein Abend im Innenhof gefällig?</h2>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={`/${site.id}/reservierung`} class="btn-primary">Jetzt reservieren</a>
        <a href={`/${site.id}/galerie`} class="btn-ghost">Galerie ansehen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Live "open now" hint in Berlin time, driven by the weekly schedule.
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Berlin',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
  }).formatToParts(new Date());
  const get = (t: string) => parts.find((p) => p.type === t)!.value;
  const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
  const minutes = Number(get('hour')) * 60 + Number(get('minute'));
  const statusEl = document.getElementById('open-status')!;
  const schedule: Record<number, { open: number; close: number } | null> = JSON.parse(statusEl.dataset.schedule!);
  const today = schedule[day];
  const open = !!today && minutes >= today.open && minutes < today.close;

  const fmt = (m: number) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
  const short = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  // Next opening after today: "morgen ab 15:00" or "Di ab 15:00".
  const nextOpening = () => {
    for (let i = 1; i <= 7; i++) {
      const slot = schedule[(day + i) % 7];
      if (slot) return `${i === 1 ? 'morgen' : short[(day + i) % 7]} ab ${fmt(slot.open)}`;
    }
    return '';
  };

  const status = statusEl;
  if (open && today) status.textContent = `Jetzt geöffnet · bis ${fmt(today.close)}`;
  else if (!today) status.textContent = `Heute Ruhetag · ${nextOpening()}`;
  else if (minutes < today.open) status.textContent = `Heute ab ${fmt(today.open)} geöffnet`;
  else status.textContent = `Geschlossen · ${nextOpening()}`;

  if (!open) {
    document.getElementById('open-ping')!.remove();
    document.getElementById('open-dot')!.classList.replace('bg-gold', 'bg-white/40');
  }
</script>
