---
import Icon from './Icon.astro';
import type { Location } from '../data/site';

interface Props {
  location: Location;
}

const { location: site } = Astro.props;
---

<!-- Thumb-reach action bar, phones only -->
<nav
  class="mobile-bar-in fixed inset-x-0 bottom-0 z-40 border-t border-ink/10 bg-cream/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden"
  aria-label="Schnellaktionen"
>
  <div class="grid grid-cols-4">
    <a
      href="/?standort"
      class="flex flex-col items-center gap-1 py-2.5 text-xs font-medium text-ink-soft active:bg-ink/5"
      aria-label={`Standort wechseln – aktuell ${site.shortName}`}
    >
      <Icon name="pin" class="size-5" />
      Standort
    </a>
    <a href={site.phoneHref} class="flex flex-col items-center gap-1 py-2.5 text-xs font-medium text-ink-soft active:bg-ink/5">
      <Icon name="phone" class="size-5" />
      Anrufen
    </a>
    <a href={`/${site.id}/reservierung`} class="flex flex-col items-center gap-1 py-2.5 text-xs font-medium text-ink-soft active:bg-ink/5">
      <Icon name="calendar" class="size-5" />
      Reservieren
    </a>
    <a
      href={`/${site.id}/bestellen`}
      class="m-1.5 flex flex-col items-center gap-1 rounded-2xl bg-tomato py-1.5 text-xs font-semibold text-white active:bg-tomato-dark"
    >
      <Icon name="bag" class="size-5" />
      Bestellen
    </a>
  </div>
</nav>
